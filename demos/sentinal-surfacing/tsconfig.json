{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noImplicitAny": false, "noEmit": true, "skipLibCheck": true, "allowJs": true, "resolveJsonModule": true,
    "isolatedModules": true, "paths": { "@/*": ["./*"], "next/image": ["./src/lib/next-image.tsx"] }, "types": ["vite/client", "node"]
  },
  "include": ["src", "config", "components", "api", "lib"]
}
