{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/checkout/", "destination": "https://gafflowresinfinishes.com/checkout/", "permanent": false },
    { "source": "/my-account/", "destination": "https://gafflowresinfinishes.com/my-account/", "permanent": false },
    { "source": "/cliens-contract-gafflow-1/", "destination": "/policies/", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
