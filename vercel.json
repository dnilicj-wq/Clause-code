{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "index.html"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/master-template-v3": false,
      "claude/newpave-demo": false
    }
  }
}
